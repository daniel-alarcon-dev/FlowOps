# Copy this file to .env and replace every value.
# These placeholders are fake. Never commit real secrets.

# Postgres connection string. The API and drizzle-kit read only this variable.
DATABASE_URL=postgresql://user:password@localhost:5432/flowops

# Required. The server refuses to start when this is missing.
SESSION_SECRET=replace-with-a-long-random-string

# Demo seed runs only when this is exactly "true".
# api/seed.ts also refuses to run when NODE_ENV=production.
# Leave this false on Render.
SEED_DEMO=false

# Passwords used only when creating seeded users. Fake placeholders.
# SYSTEM_ADMIN_PASSWORD: system admin created by api/seed.ts and api/bootstrap.ts
# SEED_MANAGER_PASSWORD: manager user "admin" created by api/seed.ts
# DEMO_USER_PASSWORD: demo user created by api/bootstrap.ts when SEED_DEMO=true
# ADMIN_PASSWORD: local crear-admin.ts script (not committed)
SYSTEM_ADMIN_PASSWORD=change-me-system-admin
SEED_MANAGER_PASSWORD=change-me-manager
DEMO_USER_PASSWORD=change-me-demo
ADMIN_PASSWORD=change-me-admin
